<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!-- Name and Publisher are assigned by Partner Center when the app name is
       reserved; the Store rejects a package whose identity differs. -->
  <Identity
    Name="BarretoTech.ArchgateCLI"
    Publisher="CN=52AEAA9B-8639-4CFD-B7E8-1E7007C75EA5"
    Version="1.60.2.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Archgate CLI</DisplayName>
    <PublisherDisplayName>Barreto Tech</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 1903 is the first release where edits to existing files under
         %APPDATA% reach the real file instead of a package-private copy. -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.18362.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="Archgate"
      Executable="archgate.exe"
      EntryPoint="Windows.FullTrustApplication">
      <!-- The app keeps its Start menu entry: the Store accepts
           AppListEntry="none" only from publishers holding a headless-app
           waiver. -->
      <uap:VisualElements
        DisplayName="Archgate CLI"
        Description="Enforce Architecture Decision Records as executable rules, for humans and AI agents."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Puts `archgate` on PATH for every terminal. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="archgate.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

{
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "permissions": {
    "allow": [
      "Bash(oxfmt *)",
      "Bash(oxlint *)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bun install *)",
      "Bash(git *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(rm *)",
      "Bash(proto *)",
      "Skill(archgate:reviewer)",
      "Skill(archgate:lessons-learned)",
      "Skill(archgate:adr-author)",
      "WebSearch",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "bun run hook:format-file" }]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run hook:worktree-create",
            "timeout": 60,
            "statusMessage": "Installing dependencies in worktree..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hook:session-start",
            "timeout": 120,
            "statusMessage": "Installing dependencies in cloud session..."
          }
        ]
      }
    ]
  },
  "agent": "archgate:developer"
}

{
  "name": "archgate",
  "version": "0.55.0",
  "description": "Enforce Architecture Decision Records as executable rules — for both humans and AI agents",
  "keywords": [
    "adr",
    "archgate",
    "architecture-decision-records",
    "cli",
    "governance",
    "linter"
  ],
  "homepage": "https://cli.archgate.dev",
  "bugs": {
    "url": "https://github.com/archgate/cli/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Archgate",
    "url": "https://archgate.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archgate/cli.git"
  },
  "bin": {
    "archgate": "shims/npm/archgate.cjs"
  },
  "files": [
    "shims/npm/archgate.cjs"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "build:check": "bun build src/cli.ts --compile --bytecode --outfile dist/.build-check && rm -f dist/.build-check dist/.build-check.exe",
    "build:winget": "bun run shims/winget/build.ts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "check": "bun run src/cli.ts check",
    "cli": "bun run src/cli.ts",
    "commit": "czg",
    "docs:build": "cd docs && bunx --bun astro build",
    "docs:dev": "cd docs && bunx --bun astro dev",
    "docs:preview": "cd docs && bunx --bun astro preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:file": "oxfmt --write",
    "hook:format-file": "bun run scripts/format-file-hook.ts",
    "hook:session-start": "bun run scripts/session-start.ts",
    "hook:worktree-create": "bun run scripts/worktree-create.ts",
    "knip": "knip",
    "licenses": "bun pm licenses",
    "lint": "bun run scripts/ensure-rules-dts.ts && oxlint --deny-warnings .",
    "profile:cpu": "bun --cpu-prof-md --cpu-prof-dir=.profiles src/cli.ts",
    "profile:heap": "bun --heap-prof-md --heap-prof-dir=.profiles src/cli.ts",
    "test": "bun test --timeout 60000 --parallel",
    "test:changed": "bun test --timeout 60000 --parallel --changed",
    "test:coverage": "bun test --timeout 60000 --coverage",
    "test:watch": "bun test --watch --timeout 60000",
    "typecheck": "bun run scripts/ensure-rules-dts.ts && tsc --build",
    "validate": "bun run lint && bun run typecheck && bun run format:check && bun run test && bun run check && bun run knip && bun run build:check",
    "validate:coverage": "bun run lint && bun run typecheck && bun run format:check && bun run test:coverage && bun run check && bun run knip && bun run build:check"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@sentry/node-core": "10.70.0",
    "@simple-release/npm": "3.2.5",
    "@types/bun": "1.4.0",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-angular": "9.3.0",
    "czg": "1.13.2",
    "fast-check": "4.9.0",
    "inquirer": "14.0.2",
    "knip": "6.32.2",
    "meriyah": "7.3.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "posthog-node": "5.49.1",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "readme": "README.md"
}
